# Copy to .env and fill in. The key stays on the server; the browser never sees it.
ANTHROPIC_API_KEY=

# Optional
# TUTOR_MODEL=claude-opus-5-5
# TUTOR_EFFORT=low        # low | medium | high — higher is slower but more thorough
# PORT=3000
# HOST=127.0.0.1          # use 0.0.0.0 to open it from a tablet on the same Wi-Fi
